---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.svelte";
import Counter from "../components/Counter.svelte";
import { getProducts, searchProducts, CATEGORIES } from "../data/products";

// SSR: read query params from the incoming request
const { url } = Astro.request;
const params = new URL(url).searchParams;
const categoryParam = params.get("category") ?? "";
const searchQuery = params.get("q") ?? "";

// Resolve which data to show — search takes priority over category filter
const products = searchQuery
    ? searchProducts(searchQuery)
    : getProducts(categoryParam || null);
---

<Layout title="Sản phẩm">
    <div class="page-header">
        <h1 class="page-title">Sản phẩm</h1>
        <p class="page-subtitle">
            {products.length} sản phẩm
            {categoryParam && !searchQuery ? `· ${categoryParam}` : ""}
            {searchQuery ? `· kết quả cho "${searchQuery}"` : ""}
        </p>
    </div>

    <!-- Search — form GET so it works without JS -->
    <form class="search-wrap" method="get" action="/posts">


        <input
            class="search-input"
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Tìm kiếm sản phẩm Shopee..."
            autocomplete="off"
        />
        <button id="search-btn">🔍 Tìm kiếm</button>
        {categoryParam && <input type="hidden" name="category" value={categoryParam} />}

    </form>
    <!-- RESULT -->
    <div id="result" class="result-box">
      <div class="result-content">
        <a id="result-text" class="result-link" target="_blank"></a>
        <button id="copy-btn" class="copy-btn">Copy</button>
      </div>
      <span id="copy-status" class="copy-status"></span>
    </div>

    <!-- 🔥 OVERLAY LOADING -->
    <div id="overlay" class="overlay">
      <div class="spinner"></div>
      <p class="loading-text">Đang xử lý...</p>
    </div>

    <style>
    /* Result */
    .result-box {
      margin-top: 10px;
      border: 1px solid #e8eaf0;
      border-radius: 10px;
      padding: 12px;
      background: #fff;
    }

    .result-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .result-link {
      color: #2563eb;
      font-size: 13px;
      word-break: break-all;
    }

    .copy-btn {
      padding: 6px 12px;
      background: #ee4d2d;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }

    /* ✅ OVERLAY FULL SCREEN */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(255,255,255,0.85);
      z-index: 9999;

      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .overlay.active {
      display: flex;

    }
    /* ✅ SPINNER XỊN (gradient + glow) */
    .spinner {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background:
        conic-gradient(from 0deg, #ee4d2d, #f97316, #ee4d2d);
      mask: radial-gradient(farthest-side, transparent 70%, black 71%);
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .loading-text {
      margin-top: 12px;
      font-size: 14px;
      color: #6b7280;
    }

    /* Copy status */
    .copy-status {
      display: block;
      margin-top: 6px;
      font-size: 11px;
      color: #10b981;
    }
    </style>
    <script is:inline>
    function showLoading() {
      document.getElementById("overlay").style.display = "flex";
    }

    function hideLoading() {
      document.getElementById("overlay").style.display = "none";

    }
      function getLink(input) {
        if (!input) return false;

        const isLink = /^https?:\/\//i.test(input);

        if (!isLink) return false;
        const link = input;
        showLoading();
        fetch(
            "https://takes-sculpture-insurance-constitutional.trycloudflare.com/click",
            {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ url: link }),
            },
        )
            .then((res) => res.text())
            .then((data) => {
                document.getElementById("result-text").innerText =
                    data;
                hideLoading();
            })
            .catch((err) => {
                document.getElementById("result-text").innerText =
                    "Error: " + err;
                hideLoading();
            });

        return true;
      }


      document.addEventListener("DOMContentLoaded", () => {
          const form = document.querySelector(".search-wrap");
          const input = document.querySelector('input[name="q"]');

          form.addEventListener("submit", (e) => {
            const value = input.value;

            console.log("Submit:", value);

            const handled = getLink(value);

            // ✅ nếu là link → chặn submit
            if (handled) {
              e.preventDefault();
            }
            // ❌ nếu không phải link → form submit bình thường (SSR search chạy)
          });
          // copy
          document.getElementById("copy-btn").addEventListener("click", async () => {
            const text = document.getElementById("result-text").textContent;
            const status = document.getElementById("copy-status");

            await navigator.clipboard.writeText(text);
            status.innerText = "✅ Đã copy!";


            setTimeout(() => (status.innerText = ""), 2000);
          });
        });

    </script>

    <!-- Category tabs — each is a link, active state resolved SSR -->
    <nav class="tabs" aria-label="Danh mục">
        <a
            href="/posts"
            class={`tab${!categoryParam && !searchQuery ? " active" : ""}`}
        >
            Tất cả
            <span class="tab-count">{CATEGORIES.reduce((s, c) => s + c.count, 0)}</span>
        </a>
        {CATEGORIES.map((cat) => (
            <a
                href={`/posts?category=${encodeURIComponent(cat.id)}`}
                class={`tab${categoryParam === cat.id && !searchQuery ? " active" : ""}`}
            >
                {cat.label}
                <span class="tab-count">{cat.count}</span>
            </a>
        ))}
    </nav>

    <!-- Product grid -->
    {products.length > 0 ? (
        <div class="product-grid">
            <!-- Product gold -->
            <Counter></Counter>
            {products.map((p) => (
                <ProductCard
                    image={p.image}
                    title={p.name}
                    price={p.price}
                    originalPrice={p.originalPrice}
                    commission={p.commissionRate}
                    sold={p.sold}
                    href={p.affiliateLink}
                />
            ))}
        </div>

    ) : (
        <div class="empty-state">
            <p>Không tìm thấy sản phẩm nào{searchQuery ? ` cho "${searchQuery}"` : ""}.</p>
            <a href="/posts">Xem tất cả sản phẩm</a>
        </div>
    )}
</Layout>

<style is:global>
    main { max-width: 1400px !important; }
</style>

<style>
    .page-header { margin-bottom: 20px; }
    .page-title  { font-size: 22px; font-weight: 700; color: #1a1a2e; margin-bottom: 4px; }
    .page-subtitle { font-size: 13px; color: #9ca3af; }

    /* Search */
    .search-wrap {
        position: relative;
        margin-bottom: 20px;
    }
    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        pointer-events: none;
    }
    .search-input {

        width: 100%;
        height: 44px;
        padding: 0 16px 0 42px;
        border: 1px solid #e8eaf0;
        border-radius: 10px;
        background: #fff;
        font-size: 14px;
        color: #1a1a2e;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-input:focus {
        border-color: #ee4d2d;
        box-shadow: 0 0 0 3px rgba(238, 77, 45, 0.08);
    }
    .search-input::placeholder { color: #9ca3af; }
    #search-btn {

        height: 44px;
        padding: 0 20px;
        background: #ee4d2d;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s;
        font-family: inherit;
    }

    #search-btn:hover {
        background: #d44326;
    }

    /* Tabs */
    .tabs {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 4px;
        margin-bottom: 24px;
        scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }

    .tab {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        white-space: nowrap;
        border: 1px solid #e8eaf0;
        background: #fff;
        text-decoration: none;
        transition: all 0.15s;
    }
    .tab:hover { color: #1a1a2e; border-color: #d1d5db; }
    .tab.active { background: #ee4d2d; color: #fff; border-color: #ee4d2d; }
    .tab.active .tab-count { background: rgba(255,255,255,0.25); color: #fff; }

    .tab-count {
        font-size: 11px;
        font-weight: 600;
        background: #f3f4f6;
        color: #6b7280;
        padding: 1px 6px;
        border-radius: 10px;
        line-height: 1.4;
    }

    /* Product grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 16px;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 64px 0;
        color: #9ca3af;
    }
    .empty-state a {
        display: inline-block;
        margin-top: 12px;
        color: #ee4d2d;
        font-weight: 600;
        text-decoration: none;
    }
    .empty-state a:hover { text-decoration: underline; }
</style>
