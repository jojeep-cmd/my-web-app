---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Aff | My Web App">
    <h1>👨‍💻 Affiliate</h1>

    <section class="intro">
        <p>
            Xin chào! Tôi là một <strong>Full-stack Developer</strong> đam mê xây
            dựng các ứng dụng web hiệu năng cao và thân thiện với người dùng.
        </p>
    </section>

    <div class="search-group">
        <div class="input-wrap">
            <span class="input-icon">✉️</span>
            <input
                type="email"
                id="email-input"
                placeholder="Nhập địa chỉ email..."
                autocomplete="off"
            />
        </div>
        <button id="search-btn">🔍 Tìm kiếm</button>
    </div>

    <div class="table-wrap">
        <table class="result-table">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Response</th>
                    <th>Hoa hồng dự kiến</th>
                    <th>Hoa hồng ròng</th>
                </tr>
            </thead>
            <tbody id="data-container">
                <tr class="empty-row">
                    <td colspan="3"
                        >Nhập email và nhấn Tìm kiếm để xem kết quả.</td
                    >
                </tr>
            </tbody>
        </table>
    </div>

    <script is:inline>
        document
            .getElementById("search-btn")
            .addEventListener("click", async () => {
                const email = document
                    .getElementById("email-input")
                    .value.trim();
                if (!email) {
                    alert("Vui lòng nhập email trước khi tìm!");
                    return;
                }

                const url =
                    "https://script.google.com/macros/s/AKfycbwg2GRFIqp0eb0tVNIw0saoE-GvYuyUwMYbYBTgyony_Es6gmb1nVYTO1VuEwJx7MX0pQ/exec?email=" +
                    encodeURIComponent(email);

                try {
                    const res = await fetch(url);
                    const data = await res.json();

                    const container = document.getElementById("data-container");
                    container.innerHTML = "";

                    if (data.length === 0) {
                        container.innerHTML = `<tr class="empty-row"><td colspan="4">Không tìm thấy dữ liệu cho email này.</td></tr>`;
                        return;
                    }

                    data.forEach((item) => {
                        const tr = document.createElement("tr");
                        tr.innerHTML = `
                            <td class="td-subject" style="border:1px solid #000;" data-label="Subject">${item.Subject ?? "—"}</td>
                            <td class="td-message" style="border:1px solid #000;" data-label="Message">${item.Message ?? "—"}</td>
                            <td class="td-message" style="border:1px solid #000;" data-label="Response">${item.Response ?? "—"}</td>
                            <td class="td-name" style="border:1px solid #000; text-align:center; vertical-align:middle;" data-label="Message">${item.HHD ?? "—"}</td>
                            <td class="td-name" style="border:1px solid #000; text-align:center; vertical-align:middle;" data-label="Response">${item.HHR ?? "—"}</td>
                        `;
                        container.appendChild(tr);
                    });
                } catch (err) {
                    console.error("Lỗi khi load dữ liệu:", err);
                }
            });
    </script>

    <style>
        h1 {
            font-size: 2rem;
            margin-bottom: 1rem;
            color: #1e1b4b;
        }

        p {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }

        section {
            margin: 2rem 0;
            padding: 1.5rem;
            background: #f8fafc;
            border-radius: 12px;
        }

        section h2 {
            margin-bottom: 0.75rem;
            color: #4f46e5;
        }

        ul {
            list-style: none;
            padding: 0;
        }

        li {
            padding: 0.5rem 0;
            border-bottom: 1px solid #e5e7eb;
        }

        li:last-child {
            border-bottom: none;
        }

        /* Search group */
        .search-group {
            display: flex;
            gap: 10px;
            margin: 1.5rem 0;
        }

        .input-wrap {
            position: relative;
            flex: 1;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 15px;
            pointer-events: none;
        }

        #email-input {
            width: 100%;
            height: 44px;
            padding: 0 16px 0 42px;
            border: 1px solid #e8eaf0;
            border-radius: 10px;
            font-size: 14px;
            color: #1a1a2e;
            outline: none;
            transition:
                border-color 0.15s,
                box-shadow 0.15s;
            font-family: inherit;
        }

        #email-input:focus {
            border-color: #ee4d2d;
            box-shadow: 0 0 0 3px rgba(238, 77, 45, 0.08);
        }

        #email-input::placeholder {
            color: #9ca3af;
        }

        #search-btn {
            height: 44px;
            padding: 0 20px;
            background: #ee4d2d;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s;
            font-family: inherit;
        }

        #search-btn:hover {
            background: #d44326;
        }

        /* Table */
        .table-wrap {
            border: 1px solid #000;
            border-radius: 12px;

            margin-top: 8px;
            overflow-x: auto;
            overflow-y: visible;
        }

        .result-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .result-table thead {
            background: #f5f6fa;
            border: 1px solid #000;
        }

        .result-table th {
            text-align: left;
            padding: 12px 16px;
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
            border: 1px solid #000;
        }

        .result-table tbody tr {
            border: 1px solid #000;
            transition: background 0.15s;
        }

        .result-table tbody tr:last-child {
            /*border-bottom: none;*/
            border: 1px solid #000;
        }

        .result-table tbody tr:hover {
            background: #fff9f8;
        }

        .result-table td {
            padding: 14px 16px;
            color: #374151;
            vertical-align: top;
            border: 1px solid #000;
        }

        .td-name {
            font-weight: 600;
            color: #1a1a2e !important;
            white-space: nowrap;
            text-align: center; /* căn giữa theo chiều ngang */
            vertical-align: middle; /* căn giữa theo chiều dọc */
        }

        .td-email {
            display: inline-block;
            font-size: 12px;
            color: #ee4d2d;
            background: #fff4f2;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid #fecdc7;
            white-space: nowrap;
        }

        .td-subject {
            font-weight: 500;
            color: #1a1a2e !important;
            border: 1px solid #000;
        }

        .td-message {
            color: #6b7280 !important;
            line-height: 1.5;
            max-width: 320px;
            border: 1px solid #000;
        }

        .empty-row td {
            text-align: center;
            color: #9ca3af;
            padding: 2.5rem 16px;
            font-size: 14px;
        }

        /* ── Mobile ── */
        @media (max-width: 640px) {
            .search-group {
                flex-direction: column;
            }

            #search-btn {
                width: 100%;
            }

            /* Ẩn header, mỗi row thành card */
            .result-table thead {
                /*display: none;*/
                display: table-header-group;
            }

            .result-table tbody tr {
                display: block;
                border: 1px solid #000;
                border-radius: 10px;
                margin-bottom: 10px;
                padding: 4px 0;
            }

            .result-table tbody tr:hover {
                background: #fff9f8;
            }

            /* Bỏ border giữa các td trong cùng row */
            /*.result-table tbody tr:last-child {
                border-bottom: 1px solid #000;
            }*/

            .result-table td {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                padding: 10px 14px;
                border: 1px solid #000;
                max-width: 100%;
            }

            .result-table td:last-child {
                /*border-bottom: none;*/
                border: 1px solid #000;
            }

            /* Hiện label từ data-label attribute */
            .result-table td::before {
                content: attr(data-label);
                flex-shrink: 0;
                width: 80px;
                font-size: 11px;
                font-weight: 600;
                color: #9ca3af;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                padding-top: 2px;
            }

            .td-message {
                max-width: 100%;
            }

            .empty-row td::before {
                display: none;
            }

            .empty-row td {
                justify-content: center;
            }
        }
    </style>
</Layout>
