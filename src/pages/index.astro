---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.svelte";
import Counter from "../components/Counter.svelte";
import { getProducts, searchProducts, CATEGORIES } from "../data/products";

// SSR: read query params from the incoming request
const { url } = Astro.request;
const params = new URL(url).searchParams;
const categoryParam = params.get("category") ?? "";
const searchQuery = params.get("q") ?? "";

// Resolve which data to show — search takes priority over category filter
const products = searchQuery
    ? searchProducts(searchQuery)
    : getProducts(categoryParam || null);
---

<Layout title="Sản phẩm">
    <div class="page-header">
        <h1 class="page-title">Sản phẩm</h1>
        <p class="page-subtitle">
            {products.length} sản phẩm
            {categoryParam && !searchQuery ? `· ${categoryParam}` : ""}
            {searchQuery ? `· kết quả cho "${searchQuery}"` : ""}
        </p>
    </div>

    <!-- Search — form GET so it works without JS -->
    <form class="search-wrap" method="get" action="/posts">
        <span class="search-icon">🔍</span>
        <input
            class="search-input"
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Tìm kiếm sản phẩm Shopee..."
            autocomplete="off"
        />
        {categoryParam && <input type="hidden" name="category" value={categoryParam} />}
    </form>
    <div id="result">Link detected: </div>
    <br></br>
    <script is:inline>
      function getLink(input) {
        if (!input) return false;

        const isLink = /^https?:\/\//i.test(input);

        if (!isLink) return false;
        const link = input;
        fetch(
            "https://realized-prevention-guitars-shareholders.trycloudflare.com/click",
            {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ url: link }),
            },
        )
            .then((res) => res.text())
            .then((data) => {
                document.getElementById("result").innerText =
                    "Link detected: " + data;
            })
            .catch((err) => {
                document.getElementById("result").innerText =
                    "Error: " + err;
            });
        return true;
      }


      document.addEventListener("DOMContentLoaded", () => {
          const form = document.querySelector(".search-wrap");
          const input = document.querySelector('input[name="q"]');

          form.addEventListener("submit", (e) => {
            const value = input.value;

            console.log("Submit:", value);

            const handled = getLink(value);

            // ✅ nếu là link → chặn submit
            if (handled) {
              e.preventDefault();
            }
            // ❌ nếu không phải link → form submit bình thường (SSR search chạy)
          });
        });

    </script>

    <!-- Category tabs — each is a link, active state resolved SSR -->
    <nav class="tabs" aria-label="Danh mục">
        <a
            href="/posts"
            class={`tab${!categoryParam && !searchQuery ? " active" : ""}`}
        >
            Tất cả
            <span class="tab-count">{CATEGORIES.reduce((s, c) => s + c.count, 0)}</span>
        </a>
        {CATEGORIES.map((cat) => (
            <a
                href={`/posts?category=${encodeURIComponent(cat.id)}`}
                class={`tab${categoryParam === cat.id && !searchQuery ? " active" : ""}`}
            >
                {cat.label}
                <span class="tab-count">{cat.count}</span>
            </a>
        ))}
    </nav>

    <!-- Product grid -->
    {products.length > 0 ? (
        <div class="product-grid">
            <!-- Product gold -->
            <Counter></Counter>
            {products.map((p) => (
                <ProductCard
                    image={p.image}
                    title={p.name}
                    price={p.price}
                    originalPrice={p.originalPrice}
                    commission={p.commissionRate}
                    sold={p.sold}
                    href={p.affiliateLink}
                />
            ))}
        </div>

    ) : (
        <div class="empty-state">
            <p>Không tìm thấy sản phẩm nào{searchQuery ? ` cho "${searchQuery}"` : ""}.</p>
            <a href="/posts">Xem tất cả sản phẩm</a>
        </div>
    )}
</Layout>

<style is:global>
    main { max-width: 1400px !important; }
</style>

<style>
    .page-header { margin-bottom: 20px; }
    .page-title  { font-size: 22px; font-weight: 700; color: #1a1a2e; margin-bottom: 4px; }
    .page-subtitle { font-size: 13px; color: #9ca3af; }

    /* Search */
    .search-wrap {
        position: relative;
        margin-bottom: 20px;
    }
    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        pointer-events: none;
    }
    .search-input {
        width: 100%;
        height: 44px;
        padding: 0 16px 0 42px;
        border: 1px solid #e8eaf0;
        border-radius: 10px;
        background: #fff;
        font-size: 14px;
        color: #1a1a2e;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-input:focus {
        border-color: #ee4d2d;
        box-shadow: 0 0 0 3px rgba(238, 77, 45, 0.08);
    }
    .search-input::placeholder { color: #9ca3af; }

    /* Tabs */
    .tabs {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 4px;
        margin-bottom: 24px;
        scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }

    .tab {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        white-space: nowrap;
        border: 1px solid #e8eaf0;
        background: #fff;
        text-decoration: none;
        transition: all 0.15s;
    }
    .tab:hover { color: #1a1a2e; border-color: #d1d5db; }
    .tab.active { background: #ee4d2d; color: #fff; border-color: #ee4d2d; }
    .tab.active .tab-count { background: rgba(255,255,255,0.25); color: #fff; }

    .tab-count {
        font-size: 11px;
        font-weight: 600;
        background: #f3f4f6;
        color: #6b7280;
        padding: 1px 6px;
        border-radius: 10px;
        line-height: 1.4;
    }

    /* Product grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 16px;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 64px 0;
        color: #9ca3af;
    }
    .empty-state a {
        display: inline-block;
        margin-top: 12px;
        color: #ee4d2d;
        font-weight: 600;
        text-decoration: none;
    }
    .empty-state a:hover { text-decoration: underline; }
</style>
