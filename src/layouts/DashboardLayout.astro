---
interface Props {
    title: string;
    activeNav?: string;
}

const { title, activeNav = "" } = Astro.props;

const sidebarNav = [
    { label: "Dashboard", icon: "🏠", href: "/", key: "dashboard" },
    { label: "Hoa hồng", icon: "💰", href: "#", key: "affiliate", section: "Affiliate" },
    { label: "Shopee", href: "#", key: "shopee", sub: true },
    { label: "Xtra", href: "#", key: "xtra", sub: true },
    { label: "Product commission", href: "/posts", key: "product-commission", sub: true },
    { label: "Campaign", icon: "📢", href: "#", key: "campaign" },
    { label: "Creative", icon: "🎨", href: "#", key: "creative" },
    { label: "Reports", icon: "📊", href: "#", key: "reports" },
];
---

<!doctype html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body>
        <aside class="sidebar">
            <div class="sidebar-logo">
                <span class="logo-shopee">Shopee</span><span class="logo-aff">Affiliate</span>
            </div>
            <nav>
                {sidebarNav.map((item) => {
                    if (item.section) {
                        return <div class="nav-section">{item.section}</div>;
                    }
                    const isActive = activeNav === item.key;
                    const cls = ["nav-item", item.sub ? "nav-sub" : "", isActive ? "active" : ""].filter(Boolean).join(" ");
                    return (
                        <a href={item.href} class={cls}>
                            {item.icon && <span class="nav-icon">{item.icon}</span>}
                            {item.label}
                        </a>
                    );
                })}
            </nav>
        </aside>

        <div class="main-area">
            <header class="topnav">
                <button class="topnav-btn">🌐 Tiếng Việt ▾</button>
                <div class="topnav-divider"></div>
                <div class="topnav-icon">
                    🔔
                    <span class="notif-badge">3</span>
                </div>
                <div class="avatar">JD</div>
            </header>

            <main class="dashboard-content">
                <slot />
            </main>
        </div>
    </body>
</html>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f5f6fa;
        color: #1a1a2e;
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
        width: 240px;
        min-width: 240px;
        background: #fff;
        border-right: 1px solid #e8eaf0;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-logo {
        padding: 20px;
        border-bottom: 1px solid #e8eaf0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .logo-shopee { color: #ee4d2d; }
    .logo-aff    { color: #1a1a2e; }

    .sidebar nav { flex: 1; padding: 12px 0; }

    .nav-section {
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 16px 20px 6px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 20px;
        font-size: 14px;
        color: #6b7280;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
    }
    .nav-item:hover { background: #f5f6fa; color: #1a1a2e; }
    .nav-item.active {
        background: #fff4f2;
        color: #ee4d2d;
        font-weight: 600;
        border-right: 3px solid #ee4d2d;
    }

    .nav-sub { padding-left: 50px; font-size: 13px; }
    .nav-sub:hover { background: #f5f6fa; color: #1a1a2e; }
    .nav-sub.active { background: #fff4f2; color: #ee4d2d; font-weight: 600; border-right: 3px solid #ee4d2d; }

    .nav-icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }

    /* Main area */
    .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* Topnav */
    .topnav {
        height: 60px;
        background: #fff;
        border-bottom: 1px solid #e8eaf0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 28px;
        gap: 8px;
        flex-shrink: 0;
    }

    .topnav-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid #e8eaf0;
        background: #fff;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
        transition: background 0.15s;
    }
    .topnav-btn:hover { background: #f5f6fa; }

    .topnav-divider { width: 1px; height: 28px; background: #e8eaf0; margin: 0 4px; }

    .topnav-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid #e8eaf0;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        cursor: pointer;
        position: relative;
        transition: background 0.15s;
    }
    .topnav-icon:hover { background: #f5f6fa; }

    .notif-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #ee4d2d;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ee4d2d, #ff8c42);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    /* Content slot */
    .dashboard-content {
        flex: 1;
        overflow-y: auto;
        padding: 28px 32px;
    }
</style>
